# Adzuna API — get your keys at https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Airflow security keys — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# Database — used inside Docker network
DATABASE_URL=postgresql://airflow:airflow@postgres:5432/airflow

# Database — used for local scripts outside Docker
DATABASE_URL_LOCAL=postgresql://airflow:airflow@localhost:5433/airflow